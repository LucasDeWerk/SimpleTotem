# ================================================
# URL DA API PARA PEGAR O TOKEN DE CONSUMO SINC
# ================================================
URL_API_TOKEN=http://192.168.10.243:8000
# ================================================
# URL DA API PARA CONSUMIR SINC
# ================================================
URL_API_SINC=http://192.168.10.243:8000

# ================================================
# SENHA DO SUPERVISOR — funções administrativas CliSiTef (110, 123 etc.)
# ================================================
SITEF_SUPERVISOR_SENHA=000000

# ================================================
# CNPJ da empresa de automação e código de loja para os testes de
# pré-homologação Fiserv. Valores do roteiro (dados fictícios oficiais),
# confirmados por escrito pelo suporte técnico Fiserv (Tiago Soares de Souza)
# como os corretos a usar nesta etapa — não trocar por conta própria.
# CNPJ do estabelecimento nos testes onde aplicável: 31406434895111
# ================================================
SITEF_CNPJ_AUTOMACAO=12523654185985
SITEF_ID_LOJA=00000000

# ================================================
# TOKEN TLS FISERV — exemplo do roteiro de pré-homologação, usado para
# demonstrar a parametrização de ConfiguraIntSiTefInterativoEx (TipoComunicacaoExterna=TLSGWP)
# ================================================
SITEF_TLS_TOKEN=1111-2222-3333-4444

# ================================================
# ENDEREÇO DO SERVIDOR SiTef — precisa ser o mesmo de EnderecoIP em
# script/CliSiTef.ini. Antes não era definido aqui e a aplicação mandava o
# default velho (192.168.10.12), que ainda chegava mutilado ("92.") por falta
# dos delimitadores {} — a Fiserv registrou isso na trace e a transação só
# funcionava porque a CliSiTef caía no endereço do .ini. Se o servidor mudar,
# altere NOS DOIS lugares.
# ================================================
SITEF_IP=192.168.10.37
